@dataclass(frozen=True)
class Route:
    label: str
    account: str
    port: int
    service: str
    state: str

    def hostname(self, zone):
        return f"{self.label}.{zone}"


@dataclass(frozen=True)
class Closure:
    code: int = 0
    detail: str = ""

    def report(self):
        if self.code == 0:
            print("CLOSED (verified)")
        elif self.code == 2:
            print("CLOSED (verified): all routes; the front is locked")
            print(f"Cause: {self.detail}", flush=True)
        else:
            print(f"REVOCATION UNCONFIRMED: {self.detail}. Stop flat-remote on the home machine.", flush=True)
        return self.code


@dataclass(frozen=True)
class Machine:
    name: str
    kind: str
    ports: tuple
    interval: int
    count: int

    @property
    def key_file(self):
        return f"/etc/ssh/home-tunnel/{self.name}.keys"

    @property
    def endpoints(self):
        return [f"127.0.0.1:{port}" for port in self.ports]

    @property
    def account_policy(self):
        return f"home-front {self.kind} " + " ".join(map(str, self.ports))

    def settings(self):
        endpoints = " ".join(self.endpoints)
        return {
            "AuthorizedKeysFile": self.key_file,
            "AuthenticationMethods": "publickey",
            "AllowTcpForwarding": "remote" if self.kind == "listen" else "local",
            "PermitListen": endpoints if self.kind == "listen" else "none",
            "PermitOpen": endpoints if self.kind == "open" else "none",
            "GatewayPorts": "no",
            "AllowStreamLocalForwarding": "no",
            "PermitTunnel": "no",
            "X11Forwarding": "no",
            "AllowAgentForwarding": "no",
            "PermitTTY": "no",
            "PermitUserRC": "no",
            "MaxSessions": "0",
            "ForceCommand": SHELL,
            "ClientAliveInterval": str(self.interval),
            "ClientAliveCountMax": str(self.count),
        }

    def authorized_key(self, key):
        option = "permitlisten" if self.kind == "listen" else "permitopen"
        bounds = ",".join(f'{option}="{endpoint}"' for endpoint in self.endpoints)
        return f'restrict,port-forwarding,{bounds},command="{SHELL}" {key} {self.name}\n'


def rows(contents):
    for number, line in enumerate(contents.splitlines(), 1):
        fields = line.partition("#")[0].split()
        if fields:
            yield number, fields


def parse_machines(contents):
    machines = {}
    listeners = set()
    for number, fields in rows(contents):
        where = f"{MACHINES}:{number}"
        if len(fields) not in (3, 4):
            raise Error(f"{where}: expected account, kind, ports and optional alive=secondsxcount")
        name, kind, port_list = fields[:3]
        if not NAME.fullmatch(name) or name == "root" or name in machines:
            raise Error(f"{where}: invalid or duplicate account {name!r}")
        if kind not in ("listen", "open"):
            raise Error(f"{where}: expected kind listen or open")
        if not re.fullmatch(r"[0-9]{5}(?:,[0-9]{5})*", port_list):
            raise Error(f"{where}: invalid port list")
        ports = tuple(sorted(map(int, port_list.split(","))))
        if len(set(ports)) != len(ports) or any(
            not (20001 <= port <= 20099 or 20101 <= port <= 20199) for port in ports
        ):
            raise Error(f"{where}: duplicate port or port outside 20001–20099 and 20101–20199")
        if kind == "listen":
            if listeners.intersection(ports):
                raise Error(f"{where}: a listen port already belongs to another account")
            listeners.update(ports)
        alive = re.fullmatch(r"alive=([1-9][0-9]{0,9})x([1-9][0-9]{0,9})", fields[3]) if len(fields) == 4 else None
        if len(fields) == 4 and (not alive or any(int(value) > 2147483647 for value in alive.groups())):
            raise Error(f"{where}: expected alive=secondsxcount with positive integers")
        interval, count = map(int, alive.groups()) if alive else (5, 3)
        machines[name] = Machine(name, kind, ports, interval, count)
    return machines


def render(machines):
    blocks = ["# Managed by home-front. Edit /etc/home-front/machines."]
    for machine in machines.values():
        settings = "\n".join(f"    {key} {value}" for key, value in machine.settings().items())
        blocks.append(f"Match User {machine.name}\n{settings}")
    return "\n\n".join(blocks) + "\n"


def parse_routes(contents):
    routes = {}
    labels = set()
    for number, fields in rows(contents):
        where = f"{ROUTES}:{number}"
        if len(fields) != 5:
            raise Error(f"{where}: expected label, account, port, service and state")
        label, account, port, service, state = fields
        if not LABEL.fullmatch(label) or label in labels:
            raise Error(f"{where}: invalid or duplicate route label")
        if (not NAME.fullmatch(account) or not re.fullmatch(r"[1-9][0-9]{0,4}", port)
                or not NAME.fullmatch(service) or service in routes or state not in ("on", "off")):
            raise Error(f"{where}: invalid account, port, service or state")
        routes[service] = Route(label, account, int(port), service, state)
        labels.add(label)
    return routes


def parse_zone(contents):
    lines = [line.partition("#")[0].strip() for line in contents.splitlines()]
    lines = [line for line in lines if line]
    label = r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?"
    setting = re.fullmatch(rf"zone\s*=\s*({label}(?:\.{label})+)", lines[0]) if len(lines) == 1 else None
    if not setting or len(setting[1]) > 236:
        raise Error(f"{FRONT_CONFIG}: expected zone = home.example.net")
    return setting[1]


def recorded_machine(name, comment):
    try:
        kind, ports = comment.removeprefix("home-front ").split(" ", 1)
        machine = parse_machines(f"{name} {kind} {ports.replace(' ', ',')}")[name]
        if machine.account_policy == comment:
            return machine
    except (Error, KeyError, ValueError):
        pass
    raise Error(f"{name}: invalid home-front policy comment")


def render_front(routes, zone, map_path):
    mapping = "\n".join(f"{route.hostname(zone)} {route.service}" for route in routes)
    lookup = f"req.ssl_sni,lower,map({map_path})"
    acl_lookup = lookup
    if re.search(r"[^a-zA-Z0-9/_.-]", str(map_path)):
        lookup = f'req.ssl_sni,lower,map("{map_path}")'
        acl_lookup = f"'{lookup}'"
        lookup = f"'%[{lookup}]'"
    else:
        lookup = f"%[{lookup}]"
    config = f"""\
# Managed by home-front.
global
    user haproxy
    group haproxy
    log stdout format raw local0
    hard-stop-after 10m
defaults
    mode tcp
    timeout connect 3s
    timeout client 10m
    timeout server 10m
frontend home
    bind :{FRONT_PORT}
    bind :::{FRONT_PORT} v6only
    maxconn 128
    log global
    stick-table type ipv6 size 64k expire 10m store conn_cur,conn_rate(10s)
    tcp-request connection track-sc0 src,ipmask(32,64)
    tcp-request connection reject if {{ sc0_conn_cur gt 8 }} || {{ sc0_conn_rate gt 30 }}
    tcp-request inspect-delay 5s
    tcp-request content reject unless {{ req.ssl_hello_type 1 }}
    tcp-request content reject unless {{ {acl_lookup} -m found }}
    use_backend {lookup}
    log-format "%ci %b %Tw/%Tc/%Tt %U/%B %ts"
"""
    for route in routes:
        config += f"""
backend {route.service}
    retries 1
    server s 127.0.0.1:{route.port} maxconn 32
"""
    return config.encode(), (mapping + "\n" if mapping else "").encode()


def tls_answer(address, name):
    # Generate a ClientHello, then read the raw TCP reply. Even a TLS alert counts as an answer.
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    context.check_hostname = False
    outgoing = ssl.MemoryBIO()
    client = context.wrap_bio(ssl.MemoryBIO(), outgoing, server_hostname=name)
    try:
        client.do_handshake()
    except ssl.SSLWantReadError:
        pass
    with socket.create_connection((address, FRONT_PORT), timeout=6) as connection:
        connection.sendall(outgoing.read())
        try:
            return bool(connection.recv(1))
        except ConnectionResetError:
            return False


def parse_sources(contents):
    sources = []
    for number, fields in rows(contents):
        if len(fields) == 2 and re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9.-]*", fields[0]):
            try:
                address = ipaddress.ip_address(fields[1])
                if "%" not in fields[1]:
                    sources.append((fields[0], str(address)))
                    continue
            except ValueError:
                pass
        raise Error(f"{SOURCES}:{number}: expected hostname and IP address")
    if not sources:
        raise Error(f"{SOURCES}: list at least one admin source")
    return sources


def read_public_key(path):
    fields = path.read_text().strip().splitlines()
    parts = fields[0].split(maxsplit=2) if len(fields) == 1 else []
    return public_key(parts)


def public_key(parts):
    if len(parts) >= 2 and parts[0] == "ssh-ed25519":
        try:
            blob = base64.b64decode(parts[1], validate=True)
        except ValueError:
            blob = b""
        if len(blob) == 51 and blob.startswith(b"\x00\x00\x00\x0bssh-ed25519\x00\x00\x00\x20"):
            return "ssh-ed25519 " + base64.b64encode(blob).decode("ascii")
    raise Error("expected one plain ssh-ed25519 public key")


def effective_values(output):
    settings = {}
    for line in output.splitlines():
        key, sep, value = line.partition(" ")
        if sep:
            settings[key] = f"{settings[key]} {value}" if key in settings else value
    return settings


def config_keyword(line, path):
    line = line.lstrip()
    if not line or line.startswith("#"):
        return ""
    keyword = re.split(r"[\s=]", line, maxsplit=1)[0]
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9]*", keyword):
        raise Error(f"{path}: quoted or noncanonical sshd keyword {keyword!r}")
    return keyword


def account_processes(name, uid):
    # A named authentication worker may still be root or use the privilege-separation UID.
    title = rf"^sshd(-session|-auth)?: {name} \[(priv|preauth|net)\]$"
    return (("-u", uid), ("-f", "--", title))


def ssh_pattern(value, pattern):
    return re.fullmatch(re.escape(pattern).replace(r"\*", ".*").replace(r"\?", "."), value) is not None


def root_matches(pattern, host, address):
    user, separator, hosts = pattern.rpartition("@")
    if not separator:
        return ssh_pattern("root", pattern)
    if not ssh_pattern("root", user):
        return False
    matched = False
    for item in hosts.split(","):
        value = item.removeprefix("!")
        if "/" in value:
            address_matches = ipaddress.ip_address(address) in ipaddress.ip_network(value)
        else:
            address_matches = ssh_pattern(address, value)
        if address_matches or ssh_pattern(host.lower(), value.lower()):
            if item.startswith("!"):
                return False
            matched = True
    return matched


def sync_directory(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def interrupted(signum, frame):
    raise KeyboardInterrupt


@dataclass(frozen=True)
class File:
    data: bytes
    mode: int
    owner: tuple
    times: tuple | None = field(default=None, compare=False)

    @classmethod
    def read(cls, path):
        try:
            info = path.lstat()
        except FileNotFoundError:
            return None
        if not stat.S_ISREG(info.st_mode):
            raise Error(f"{path}: expected a regular file")
        return cls(path.read_bytes(), stat.S_IMODE(info.st_mode), (info.st_uid, info.st_gid),
                   (info.st_atime_ns, info.st_mtime_ns))

    def write(self, path):
        with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as temp:
            temporary = Path(temp.name)
            try:
                temp.write(self.data)
                os.fchown(temp.fileno(), *self.owner)
                os.fchmod(temp.fileno(), self.mode)
                temp.flush()
                if self.times is not None:
                    os.utime(temp.fileno(), ns=self.times)
                os.fsync(temp.fileno())
                temporary.replace(path)
                sync_directory(path.parent)
            finally:
                temporary.unlink(missing_ok=True)

class Server:
    def __init__(self, root="/", runner=None):
        self.root = Path(root).resolve()
        self.runner = runner
        self.owner = (0, 0) if self.root == Path("/") else (os.geteuid(), os.getegid())
        if self.root != Path("/") and not runner:
            raise Error("HOME_FRONT_ROOT requires HOME_FRONT_RUNNER")

    def path(self, path):
        return self.root / path.lstrip("/")

    def run(self, *argv, allowed=(0,), timeout=30):
        if self.runner:
            command = [self.runner, *argv]
        elif argv[0] == "sshd":
            command = ["/usr/sbin/sshd", *argv[1:]]
        else:
            command = argv
        result = subprocess.run(command, capture_output=True, text=True, timeout=timeout,
                                env={**os.environ, "LC_ALL": "C"})
        if result.returncode not in allowed:
            detail = result.stderr.strip() or result.stdout.strip()
            raise Error(f"{argv[0]} exited {result.returncode}" + (f": {detail}" if detail else ""))
        return result

    @contextmanager
    def locked(self, *, shared=False):
        with self.path(LOCK).open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_SH if shared else fcntl.LOCK_EX)
            yield

    def storage(self, path, mode):
        directory = self.path(path)
        directory.mkdir(mode=mode, parents=True, exist_ok=True)
        info = directory.lstat()
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != self.owner[0]
                or stat.S_IMODE(info.st_mode) & ~mode):
            raise Error(f"{path}: expected a directory owned by the operator with mode at most {mode:04o}")
        return directory

    def private_text(self, path):
        record = File.read(self.path(path))
        if record is None:
            raise Error(f"{path}: missing")
        if record.owner[0] != self.owner[0] or record.mode != 0o600:
            raise Error(f"{path}: expected an operator-owned file with mode 0600")
        return record.data.decode()

    def machines(self):
        return parse_machines(self.private_text(MACHINES))

    def sources(self):
        return parse_sources(self.private_text(SOURCES))

    def present(self, path):
        try:
            self.path(path).lstat()
        except FileNotFoundError:
            return False
        return True

    def front_installed(self):
        return self.present(FRONT_DROP_IN) or self.present(FRONT_CONFIG)

    def routes(self, *, optional=False):
        if optional and not self.present(ROUTES) and not self.front_installed():
            return {}
        return parse_routes(self.private_text(ROUTES))

    def zone(self):
        return parse_zone(self.private_text(FRONT_CONFIG))

    def front_locked(self):
        if self.present(FRONT_LOCK):
            return True
        if self.front_installed():
            info = self.path(STATE).lstat()
            if (not stat.S_ISDIR(info.st_mode) or info.st_uid != self.owner[0]
                    or stat.S_IMODE(info.st_mode) & ~0o700):
                raise Error(f"{STATE}: expected a private home-front state directory")
        return False

    def write_routes(self, routes):
        contents = "# label account port service state\n"
        contents += "".join(f"{r.label} {r.account} {r.port} {r.service} {r.state}\n" for r in routes.values())
        File(contents.encode(), 0o600, self.owner).write(self.path(ROUTES))
        if self.routes() != routes:
            raise Error("routes file differs on readback")

    def local_record(self, database, name):
        # Read the file itself: no name service, and a missing record is a definite answer.
        path, width = ACCOUNT_FILES[database]
        prefix = name.encode("ascii") + b":"
        lines = [line for line in self.path(path).read_bytes().split(b"\n") if line.startswith(prefix)]
        if not lines:
            return None
        try:
            fields = lines[0].decode("ascii").split(":")
        except UnicodeDecodeError:
            fields = []
        if len(lines) != 1 or len(fields) != width:
            raise Error(f"{path}: expected one record with {width} fields for {name}")
        return fields

    def route_denial(self, route):
        # Any expiry field denies the route. An activated account has no expiry field.
        account = self.local_record("passwd", route.account)
        shadow = self.local_record("shadow", route.account)
        group = self.local_record("group", GROUP)
        if account is None:
            return "is not provisioned"
        if (group is None or shadow is None or not account[2].isdigit() or int(account[2]) == 0
                or account[3] != group[2] or account[5:] != [HOME, SHELL] or not shadow[1].startswith("!")):
            return "is not a dedicated home-front account"
        if shadow[7]:
            return "is expired or not activated"
        try:
            machine = recorded_machine(route.account, account[4])
        except Error:
            return "has no home-front policy record"
        if machine.kind != "listen" or route.port not in machine.ports or not 20001 <= route.port <= 20099:
            return f"cannot listen on service port {route.port}"
        return None

    def authorize_route(self, route):
        reason = self.route_denial(route)
        if reason:
            raise RouteDenied(f"{route.service}: {route.account} {reason}")

    def front_files(self, strict=False):
        requested = [] if self.front_locked() else [r for r in self.routes().values() if r.state == "on"]
        active = []
        for route in requested:
            try:
                self.authorize_route(route)
            except RouteDenied as error:
                if strict:
                    raise Error(f"{error}. Run home-front off {route.service}, then retry") from error
                print(f"home-front: omitting route {route.service}: {error}", file=sys.stderr)
            else:
                active.append(route)
        return self.rendered_front_files(active)

    def rendered_front_files(self, active):
        zone = self.zone() if active else None
        config, mapping = render_front(active, zone, self.path(HAPROXY_MAP))
        return {HAPROXY_MAP: File(mapping, 0o600, self.owner), HAPROXY_CONFIG: File(config, 0o600, self.owner)}

    def check_front_hook(self):
        if self.root == Path("/"):
            group = self.path("/proc/self/cgroup").read_text().strip().partition("::")[2]
            if FRONT_UNIT not in Path(group).parts:
                raise Error("this hook must run inside haproxy.service")

    def hooks_effective(self):
        # Home-front alone manages the Debian unit and its single managed drop-in.
        # The acceptance harness adds its runtime drop-in only while a fixture runs.
        # Manual starts, stops, reloads and restarts are allowed only between home-front commands.
        try:
            drop_in = File.read(self.path(FRONT_DROP_IN))
            if drop_in is None or drop_in.data != FRONT_DROP_IN_CONTENT:
                return False
            reload_needed = self.run("systemctl", "show", "-p", "NeedDaemonReload", FRONT_UNIT).stdout
            if reload_needed.splitlines() != ["NeedDaemonReload=no"]:
                return False
            paths = self.run("systemctl", "show", "-p", "FragmentPath", "-p", "DropInPaths", FRONT_UNIT).stdout
            drop_ins = [FRONT_DROP_IN]
            if os.environ.get("HOME_FRONT_ACCEPTANCE") == "1":
                drop_ins.append(FRONT_ACCEPTANCE_DROP_IN)
            expected = [f"FragmentPath={FRONT_FRAGMENT}", f"DropInPaths={' '.join(drop_ins)}"]
            if sorted(paths.splitlines()) != sorted(expected):
                return False
            output = self.run("systemctl", "show", "-p", "ExecStartPre", "-p", "ExecStart",
                              "-p", "ExecReload", FRONT_UNIT).stdout
        except FRONT_ERRORS:
            return False
        commands = {name: [] for name in FRONT_COMMANDS}
        for line in output.splitlines():
            match = re.fullmatch(r"(?P<name>\w+)=\{ path=(?P<path>[^ ;]+) ; argv\[\]=(?P<argv>[^;]+)"
                                 r" ; ignore_errors=no ; [^{}]* \}", line)
            if not match or match["name"] not in commands or match["path"] != match["argv"].split(" ", 1)[0]:
                return False
            commands[match["name"]].append(match["argv"])
        return commands == FRONT_COMMANDS

    def render_for_start(self, strict=False):
        self.check_front_hook()
        self.write_front_files(self.front_files(strict))
        self.run("haproxy", "-c", "-q", "-f", str(self.path(HAPROXY_CONFIG)))

    def write_front_files(self, files):
        for path, record in files.items():
            record.write(self.path(path))

    def verify_front_files(self, files):
        if any(File.read(self.path(path)) != record for path, record in files.items()):
            raise Error("HAProxy files do not match the current routes and front lock")

    def front_processes(self):
        group = self.run("systemctl", "show", "--value", "-p", "ControlGroup", FRONT_UNIT).stdout.strip()
        if group not in ("", FRONT_CGROUP):
            raise Error("unexpected HAProxy control group")
        parent = self.path("/sys/fs/cgroup") / Path(FRONT_CGROUP).parent.name
        if not stat.S_ISDIR(parent.stat().st_mode):
            raise Error(f"{parent}: expected the system slice's control group")
        top = parent / FRONT_UNIT
        for _ in range(20):
            try:
                top.lstat()
            except FileNotFoundError:
                return {}  # The kernel removes a cgroup only when it has no member and no child.
            try:
                return self.cgroup_members(top)
            except FileNotFoundError:
                time.sleep(0.05)  # A cgroup was removed during the walk. Look again from the top.
        raise Error("the HAProxy control group kept changing")

    def cgroup_members(self, top):
        processes = {}
        pending = [top]
        while pending:
            directory = pending.pop()
            with os.scandir(directory) as entries:
                pending.extend(Path(entry.path) for entry in entries if entry.is_dir(follow_symlinks=False))
            for pid in (directory / "cgroup.procs").read_text().split():
                number = int(pid)
                try:
                    # Field 22 is start time in clock ticks since boot. The comm field can contain spaces.
                    fields = self.path(f"/proc/{number}/stat").read_text().rpartition(") ")[2].split()
                except (FileNotFoundError, ProcessLookupError):
                    continue  # The process exited after we listed it.
                if len(fields) < 20:
                    raise Error("could not read an HAProxy cgroup process start time")
                processes[number] = int(fields[19])
        return processes

    def restart_front(self, *, enable=False):
        # Every process of the front must belong to a start that began after this call.
        before = self.front_processes()
        if enable:
            self.run("systemctl", "enable", FRONT_UNIT)
            # Enabling reloads systemd's unit definitions. Verify what the restart will use.
            if not self.hooks_effective():
                self.refuse_front_mismatch()
        clock = time.CLOCK_BOOTTIME if hasattr(time, "CLOCK_BOOTTIME") else time.CLOCK_MONOTONIC
        start = time.clock_gettime_ns(clock) * os.sysconf("SC_CLK_TCK") // 10**9
        self.run("systemctl", "restart", FRONT_UNIT)
        now = self.front_processes()
        if not now or any(tick < start or before.get(pid) == tick for pid, tick in now.items()):
            raise Error("HAProxy cgroup did not fully restart")
        named = self.run("pgrep", "-x", "haproxy", allowed=(0, 1)).stdout.split()
        if any(not pid.isdigit() or int(pid) not in now for pid in named):
            raise Error("an HAProxy process exists outside the front's control group")
        if self.front_active() != "active":
            raise Error("HAProxy is not active")
        self.verify_front_files(self.front_files())

    def reload_front_worker(self, master):
        self.check_front_hook()
        # Keep the systemd reload job running until a new worker owns both listening sockets.
        # Debian's stock ExecReload returns as soon as it sends the signal.
        before = self.front_processes()
        if master <= 1 or master not in before:
            raise Error("HAProxy master is missing from its control group")
        self.run("kill", "-USR2", str(master))
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline:
            listeners = self.run("ss", "-H", "-ltnp", f"sport = :{FRONT_PORT}").stdout
            owners = {}
            for line in listeners.splitlines():
                fields = line.split()
                if len(fields) < 5:
                    raise Error("could not read HAProxy listeners from ss")
                address = fields[3]
                owners.setdefault(address, set()).update(map(int, re.findall(r"\bpid=([0-9]+)", line)))
            ipv4 = owners.get(f"0.0.0.0:{FRONT_PORT}", set())
            ipv6 = owners.get(f"[::]:{FRONT_PORT}", set())
            now = self.front_processes()
            old_listeners = {pid for pid in ipv4 | ipv6 if pid != master and pid in before and now.get(pid) == before[pid]}
            new_workers = {pid for pid in ipv4 & ipv6 if pid in now and now[pid] != before.get(pid)}
            if now.get(master) == before[master] and new_workers and not old_listeners:
                return
            time.sleep(0.05)
        raise Error("HAProxy reload did not bring up a new worker on both listeners")

    def front_enabled(self):
        return self.run("systemctl", "is-enabled", FRONT_UNIT, allowed=(0, 1, 3, 4)).stdout.strip()

    def front_active(self):
        return self.run("systemctl", "is-active", FRONT_UNIT, allowed=(0, 3, 4)).stdout.strip()

    def check_route_closed(self, routes):
        zone = self.zone() if routes else None
        names = [r.hostname(zone) for r in routes] or [None]
        probes = ((address, name) for name in names for address in ("127.0.0.1", "::1"))
        for index, (address, name) in enumerate(probes):
            # Space every connection apart to stay below HAProxy's ten-second rate limit.
            if index:
                time.sleep(0.5)
            if self.runner:
                result = self.run("tls-client-hello", address, str(FRONT_PORT), name or "", allowed=(0, 1))
                answered = result.returncode == 1
            else:
                answered = tls_answer(address, name)
            if answered:
                raise Error("HAProxy returned bytes to a TLS ClientHello for a closed route")

    def verify_front_stopped(self):
        if self.front_enabled() != "disabled":
            raise Error("HAProxy is not disabled")
        if self.front_active() not in ("inactive", "failed"):
            raise Error("HAProxy is not stopped")
        if self.front_processes() or self.has_processes((("-x", "haproxy"),)):
            raise Error("an HAProxy process still exists")
        if str(FRONT_PORT) in self.listeners():
            raise Error(f"port {FRONT_PORT} still has a listener")

    def lock_front(self):
        # Returns only when the lock's directory entry is on disk.
        directory = self.storage(STATE, 0o700)
        sync_directory(directory.parent)
        path = self.path(FRONT_LOCK)
        record = File(FRONT_LOCK_TEXT, 0o600, self.owner)
        if File.read(path) == record:
            sync_directory(directory)  # An earlier run may have renamed it without a successful sync.
        else:
            record.write(path)
        if File.read(path) != record:
            raise Error("front lock differs on readback")

    def stop_front(self, diagnostics, *, kill=False):
        actions = [("stop",), ("disable",)]
        if kill:
            actions.append(("kill", "-s", "KILL"))
        for args in actions:
            action = " ".join(args)
            try:
                result = self.run("systemctl", *args, FRONT_UNIT)
            except FRONT_ERRORS as error:
                diagnostics.append(f"{action}: {error}")
            else:
                diagnostics.append(f"systemctl {action} exited {result.returncode}")

    def refuse_front_mismatch(self):
        diagnostics = []
        self.stop_front(diagnostics)
        try:
            self.verify_front_stopped()
        except FRONT_ERRORS as error:
            details = "; ".join([*diagnostics, str(error)])
            raise Error(f"{FRONT_HOOK_ERROR}. HAProxy shutdown could not be verified: {details}") from error
        raise Error(FRONT_HOOK_ERROR)

    def disable_front(self, cause):
        # The CLI reports one outcome and exits. Ignore these signals through that report.
        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(signum, signal.SIG_IGN)
        diagnostics = [cause]
        verified = True
        try:
            self.lock_front()
        except FRONT_ERRORS as error:
            verified = False
            diagnostics.append(f"front lock: {error}")
        self.stop_front(diagnostics, kill=True)
        stopped_before_write = False
        try:
            self.verify_front_stopped()
        except FRONT_ERRORS as error:
            verified = False
            diagnostics.append(f"shutdown before render: {error}")
        else:
            stopped_before_write = True
            # This is the only CLI write outside the systemd hooks. The front is
            # verified stopped, and both files must contain zero routes.
            files = self.rendered_front_files([])
            for path, record in files.items():
                try:
                    record.write(self.path(path))
                except FRONT_ERRORS as error:
                    verified = False
                    diagnostics.append(f"{path}: {error}")
            try:
                self.verify_front_files(files)
            except FRONT_ERRORS as error:
                verified = False
                diagnostics.append(f"empty front: {error}")

        try:
            self.verify_front_stopped()
        except FRONT_ERRORS as error:
            diagnostics.append(f"shutdown after render: {error}")
            if stopped_before_write:
                self.stop_front(diagnostics, kill=True)
                try:
                    self.verify_front_stopped()
                except FRONT_ERRORS as retry_error:
                    verified = False
                    diagnostics.append(f"shutdown after retry: {retry_error}")
            else:
                verified = False
        if not self.hooks_effective():
            verified = False
            if cause != FRONT_HOOK_ERROR:
                diagnostics.append(FRONT_HOOK_ERROR)
        return Closure(2 if verified else 3, "; ".join(diagnostics))

    def close_routes(self, original, selected):
        updated = {name: replace(route, state="off") if name in selected else route
                   for name, route in original.items()}
        try:
            self.write_routes(updated)
            if not self.hooks_effective():
                raise Error(FRONT_HOOK_ERROR)
            if not self.front_locked():
                self.restart_front()
                routes = [updated[name] for name in selected]
                for port in sorted({route.port for route in routes}):
                    target = f"( dst 127.0.0.1 and dport = :{port} )"
                    if self.run("ss", "-H", "-tn", "state", "established", target).stdout.strip():
                        raise Error(f"an established connection remains to 127.0.0.1:{port}")
                self.check_route_closed(routes)
                return Closure()
        except FRONT_ERRORS as error:
            return self.disable_front(str(error))
        return self.disable_front("the front was already locked")

    def off(self, service):
        try:
            routes = self.routes()
        except FRONT_ERRORS as error:
            return self.disable_front(str(error))
        if service is not None and service not in routes:
            return Closure(3, f"{service}: route not found")
        return self.close_routes(routes, [service] if service is not None else list(routes))

    def reload_denials(self):
        try:
            routes = self.routes()
        except FRONT_ERRORS as error:
            return [f"Could not re-check recorded routes. {error}"]
        diagnostics = []
        for route in routes.values():
            if route.state != "on":
                continue
            try:
                self.authorize_route(route)
            except RouteDenied as error:
                diagnostics.append(f"{error}. Run home-front off {route.service}, then retry.")
            except FRONT_ERRORS as error:
                diagnostics.append(f"Could not re-check {route.service}. {error}")
        return diagnostics

    def change_route(self, service, account=None, port=None):
        if not self.hooks_effective():
            raise Error(FRONT_HOOK_ERROR)
        if self.front_locked():
            raise Error("the front is locked. Run home-front reconcile")
        routes = self.routes()
        zone = self.zone()
        if account is None:
            if service not in routes:
                raise Error(f"{service}: route not found")
            route = replace(routes[service], state="on")
        else:
            if not NAME.fullmatch(service) or service in routes:
                raise Error(f"{service!r}: invalid or duplicate service name")
            labels = {route.label for route in routes.values()}
            label = base64.b32encode(secrets.token_bytes(10)).decode("ascii").lower()
            while label in labels:
                label = base64.b32encode(secrets.token_bytes(10)).decode("ascii").lower()
            route = Route(label, account, port, service, "off")
        self.authorize_route(route)
        if self.front_active() != "active":
            raise Error("HAProxy must be running to reload the front. Start it or run home-front reconcile")
        if account is None:
            reload_attempted = False
            try:
                self.write_routes({**routes, service: route})
                reload_attempted = True
                self.run("systemctl", "reload", FRONT_UNIT)
            except (*FRONT_ERRORS, KeyboardInterrupt) as error:
                summary = ("route may be recorded on and its reload is unconfirmed. "
                           f"Run home-front off {service} to verify closure. {str(error) or 'Interrupted'}")
                diagnostics = self.reload_denials() if reload_attempted else []
                raise Error("\n".join([summary, *diagnostics])) from error
            return
        try:
            self.write_routes({**routes, service: route})
            self.run("systemctl", "reload", FRONT_UNIT)
        except FRONT_ERRORS:
            if self.routes() != routes:
                self.write_routes(routes)
            raise
        print(f"https://{route.hostname(zone)}:{FRONT_PORT}", flush=True)

    def reconcile(self):
        if not self.hooks_effective():
            raise Error(FRONT_HOOK_ERROR)
        routes = self.routes()
        locked = self.front_locked()
        if not locked and any(route.state == "on" for route in routes.values()):
            raise Error("the front is unlocked and routes are on")
        if locked:
            self.write_routes({name: replace(route, state="off") for name, route in routes.items()})
        self.restart_front(enable=True)
        if self.front_enabled() != "enabled":
            raise Error("HAProxy is not enabled")
        if any(route.state != "off" for route in self.routes().values()):
            raise Error("a route is not off on readback")
        self.check_route_closed(list(routes.values()))
        if locked:
            self.path(FRONT_LOCK).unlink()
        sync_directory(self.path(STATE))
        self.run("systemctl", "reload", FRONT_UNIT)
        print("Front enabled and active. All routes are off.")

    def front_firewall_rule_exists(self):
        for family in ("", "6"):
            path = f"/etc/ufw/user{family}.rules"
            if not self.present(path):
                return False
            rule = rf"-A ufw{family}-user-input -p tcp (?:-m tcp )?--dport {FRONT_PORT} -j ACCEPT"
            if not any(re.fullmatch(rule, " ".join(line.split())) for line in self.path(path).read_text().splitlines()):
                return False
        return True

    def check_package_handoff(self):
        if not self.present(ROUTES):
            return
        lock = self.path(FRONT_LOCK)
        record = File(FRONT_LOCK_TEXT, 0o600, self.owner)
        try:
            if File.read(lock) == record:
                sync_directory(lock.parent.parent)
                sync_directory(lock.parent)
                if File.read(lock) == record:
                    return
        except FRONT_ERRORS:
            pass  # All-off routes are independent proof that the start hook serves no names.
        active = [route.service for route in self.routes().values() if route.state == "on"]
        if active:
            raise Error(f"HAProxy is missing and routes are still on: {', '.join(active)}. Before installing "
                        f"HAProxy, edit {ROUTES} as root under {LOCK}, set the final field of those rows "
                        "to off, and run the installer again")

    def install_front(self, drop_in):
        directory = self.storage(str(Path(FRONT_DROP_IN).parent), 0o755)
        sync_directory(directory.parent)
        File(drop_in, 0o644, self.owner).write(self.path(FRONT_DROP_IN))
        self.run("systemctl", "daemon-reload")
        load_state = self.run("systemctl", "show", "-p", "LoadState", FRONT_UNIT)
        if load_state.stdout.strip() == "LoadState=masked":
            raise Error(f"{FRONT_UNIT} is masked. Resolve the mask before running the installer again")
        package = self.run("dpkg-query", "-W", "-f=${db:Status-Status}", "haproxy", allowed=(0, 1))
        if package.stdout.strip() != "installed":
            self.check_package_handoff()
            print("HAProxy is missing. The home-front program and systemd drop-in are installed.")
            print(f"As root, run systemctl show -p DropInPaths -p FragmentPath {FRONT_UNIT}. "
                  f"FragmentPath must be empty or {FRONT_FRAGMENT}. The only drop-in must be {FRONT_DROP_IN}.")
            print("Run the pre-APT scan in docs/HOME-FRONT.md entirely as root. Stop on any inspection error.")
            print("Once the checks pass, run apt-get install haproxy, then run the installer again.")
            print("On a fresh setup the package's start runs the home-front render hook. Until the routes and "
                  "config files are created, the render fails and HAProxy stays down.")
            return
        if not self.hooks_effective():
            self.refuse_front_mismatch()
        self.storage("/etc/home-front", 0o700)
        for path, data in ((ROUTES, b"# label account port service state\n"),
                           (FRONT_CONFIG, b"zone = home.example.net\n")):
            if not self.present(path):
                File(data, 0o600, self.owner).write(self.path(path))
            self.private_text(path)
        locked = self.front_locked()
        routes = self.routes()
        all_off = all(route.state == "off" for route in routes.values())
        if locked:
            self.run("systemctl", "disable", "--now", FRONT_UNIT)
            self.verify_front_stopped()
            print("front locked: run reconcile")
        elif all_off:
            self.restart_front(enable=True)
            if self.front_enabled() != "enabled":
                raise Error("HAProxy is not enabled")
            self.check_route_closed(list(routes.values()))
        else:
            print("routes are on. Leaving the running front as it is")
        if self.front_firewall_rule_exists():
            return
        if not (locked or all_off):
            raise Error("routes are recorded on. Run home-front off and verify closure before opening 8443")
        ufw = self.path("/etc/default/ufw").read_text()
        settings = re.findall(r"^\s*IPV6=(.*)$", ufw, re.MULTILINE)
        if len(settings) != 1 or shlex.split(settings[0], comments=True) != ["yes"]:
            raise Error("set IPV6=yes in /etc/default/ufw before opening port 8443")
        self.run("ufw", "allow", f"{FRONT_PORT}/tcp")

    def main_config(self, installing):
        original = File.read(self.path(CONFIG))
        if original is None:
            raise Error(f"{CONFIG}: missing")
        config = original.data.decode()
        lines = config.splitlines()
        managed = lines[-2:] == [MARKER, INCLUDE]
        if lines.count(MARKER) != int(managed):
            raise Error(f"{CONFIG}: misplaced or duplicated home-front marker")
        if not managed:
            if not installing:
                raise Error(f"{CONFIG}: missing final home-front Include")
            config = config.rstrip("\n") + f"\n{MARKER}\n{INCLUDE}\n"
        return original, config

    def scan_config(self, main):
        dropins = self.path(DROPINS)
        try:
            entries = sorted(os.listdir(os.fsencode(dropins)))
        except FileNotFoundError:
            entries = []
        global_lines = []
        for entry in entries:
            if not re.fullmatch(rb"[A-Za-z0-9._-]+", entry):
                raise Error(f"{dropins}: unsupported filename {entry!r}; use plain ASCII names")
            if not entry.endswith(b".conf"):
                continue
            path = dropins / entry.decode("ascii")
            if path.resolve() == self.path(MATCH).resolve():
                raise Error(f"{path}: unexpected alias of the managed Match file")
            contents = path.read_text().splitlines()
            for line in contents:
                keyword = config_keyword(line, path)
                if keyword.lower() in ("match", "include"):
                    raise Error(f"{path}: unexpected {keyword} directive")
            if not entry.startswith(b"."):
                global_lines.extend(contents)

        lines = main.splitlines()
        result = []
        seen_debian = False
        for number, line in enumerate(lines):
            keyword = config_keyword(line, CONFIG).lower()
            if keyword not in ("include", "match"):
                result.append(line)
            elif keyword == "match":
                raise Error(f"{CONFIG}: existing Match directive")
            elif line == DEBIAN_INCLUDE and not seen_debian:
                result.extend(global_lines)
                seen_debian = True
            elif line == INCLUDE and number == len(lines) - 1 and lines[number - 1] == MARKER:
                continue
            else:
                raise Error(f"{CONFIG}: unexpected Include directive: {line.strip()}")
        return "\n".join(result) + "\n"

    def effective(self, config, name, source):
        host, address = source
        return self.run("sshd", "-T", "-f", str(config), "-C",
                        f"user={name},host={host},addr={address}").stdout

    def check_service_args(self):
        keys = ("ExecStart", "Environment", "EnvironmentFiles", "PassEnvironment", "PAMName")
        output = self.run("systemctl", "show", SERVICE, "-p", "ExecStart", "-p", "Environment",
                          "-p", "EnvironmentFiles", "-p", "PassEnvironment", "-p", "PAMName").stdout
        properties = {}
        for line in output.splitlines():
            key, _, value = line.partition("=")
            if key not in keys or key in properties:
                raise Error("ssh.service has unsupported or multiple command or environment settings")
            properties[key] = value
        entry = re.fullmatch(
            r"\{\s*path=/usr/sbin/sshd\s*;\s*argv\[\]=([^;]+);\s*ignore_errors=(?:yes|no)\s*;[^{}]*\}\s*",
            properties.get("ExecStart", ""),
        )
        args = entry[1].split() if entry else []
        safe_flags = {"-D", "-e"}
        if args[:1] != ["/usr/sbin/sshd"] or set(args[1:]) - safe_flags - {"$SSHD_OPTS"}:
            raise Error("ssh.service ExecStart has unsupported sshd arguments")
        if "$SSHD_OPTS" not in args:
            return
        env_files = properties.get("EnvironmentFiles", "").strip()
        if env_files not in ("", "/etc/default/ssh (ignore_errors=yes)", "/etc/default/ssh (ignore_errors=no)"):
            raise Error("ssh.service uses an unsupported EnvironmentFile for SSHD_OPTS")
        if ("SSHD_OPTS" in properties.get("PassEnvironment", "").split()
                or "SSHD_OPTS=" in properties.get("Environment", "") or properties.get("PAMName")):
            raise Error("ssh.service SSHD_OPTS must come from /etc/default/ssh")
        defaults = File.read(self.path("/etc/default/ssh"))
        if defaults:
            for line in defaults.data.decode().splitlines():
                line = line.strip()
                if not line or line.startswith(("#", ";")):
                    continue
                key, sep, value = line.partition("=")
                if not sep or "\\" in line:
                    raise Error("/etc/default/ssh: unsupported environment assignment")
                words = " ".join(shlex.split(value)).split()
                if key.strip() == "SSHD_OPTS" and set(words) - safe_flags:
                    raise Error("ssh.service SSHD_OPTS has unsupported sshd arguments")

    def root_baseline(self, sources):
        baseline = {}
        groups = None
        for source in sources:
            host, address = source
            output = self.effective(self.path(CONFIG), "root", source)
            settings = effective_values(output)
            methods = settings.get("authenticationmethods", "").replace(",", " ").split()
            if settings.get("pubkeyauthentication") != "yes" or settings.get("permitrootlogin", "no") == "no":
                raise Error(f"root baseline cannot use public-key login from {host} {address}")
            if not {"any", "publickey"}.intersection(methods):
                raise Error(f"root baseline AuthenticationMethods excludes publickey from {host} {address}")
            lookup_host = host if settings.get("usedns") == "yes" else address
            for directive in ("DenyUsers", "AllowUsers", "DenyGroups", "AllowGroups"):
                patterns = settings.get(directive.lower(), "").split()
                if not patterns:
                    continue
                if directive.endswith("Users"):
                    matched = any(root_matches(pattern, lookup_host, address) for pattern in patterns)
                else:
                    if groups is None:
                        groups = self.run("id", "-Gn", "root").stdout.split()
                    if not groups:
                        raise Error("root baseline group membership could not be checked")
                    matched = any(ssh_pattern(group, pattern) for group in groups for pattern in patterns)
                if matched != directive.startswith("Allow"):
                    raise Error(f"root baseline {directive} excludes root from {host} {address}")
            baseline[source] = output
        return baseline

    def check_admin(self, config, baseline):
        for source, before in baseline.items():
            if self.effective(config, "root", source) != before:
                raise Error(f"root effective sshd settings changed for {source[0]} {source[1]}")

    def check_machine(self, config, machine, admin):
        expected = {key.lower(): value for key, value in machine.settings().items()}
        expected.update(pubkeyauthentication="yes", disableforwarding="no",
                        authorizedkeyscommand="none", trustedusercakeys="none")
        for source in (*PROBES, admin):
            effective = effective_values(self.effective(config, machine.name, source))
            for key, value in expected.items():
                actual = effective.get(key)
                if actual != value:
                    raise Error(f"{machine.name} at {source[1]}: {key} is {actual!r}, expected {value!r}")

    def check_existing_keys(self, machines):
        for path in self.path("/etc/ssh/home-tunnel").glob("*.keys"):
            name = path.stem
            if name not in machines:
                raise Error(f"{path}: declare the account and remove it before dropping its machines row")
            record = File.read(path)
            if record.owner != self.owner or record.mode != 0o644:
                raise Error(f"{path}: expected an operator-owned key file with mode 0644")
            lines = record.data.decode().strip().splitlines()
            fields = lines[0].split(maxsplit=3) if len(lines) == 1 else []
            if len(fields) != 4 or not fields[0].startswith("restrict,port-forwarding,") or fields[3] != name:
                raise Error(f"{path}: expected a home-front key line")
            key = public_key(fields[1:3])
            if record.data != machines[name].authorized_key(key).encode():
                raise Error(f"{path}: kind and ports are fixed for this account; use a new account name")

    def check_fallback(self, baseline):
        # The global config applies to these accounts if the trailing Include disappears.
        if os.path.lexists(self.path(HOME)):
            raise Error(f"{HOME}: dedicated account home must be absent")
        for settings in baseline.values():
            values = effective_values(settings)
            key_files = values.get("authorizedkeysfile", "").split()
            if not key_files or any(path.startswith("/") or "%" in path for path in key_files):
                raise Error("global AuthorizedKeysFile must use literal home-relative paths or none")
            for method in ("hostbasedauthentication", "gssapiauthentication", "kbdinteractiveauthentication"):
                if values.get(method, "no") != "no":
                    raise Error(f"global {method} must be disabled for home-front to fail closed")
            for key in ("authorizedkeyscommand", "trustedusercakeys"):
                if values.get(key, "none") != "none":
                    raise Error(f"global {key} must be none for home-front to fail closed")

    def manual_restore(self, backup):
        restore = f"sudo bash {shlex.quote(str(backup / 'restore.sh'))}"
        return (
            f"Backup: {backup}\n"
            f"{restore} && \\\n"
            "sudo /usr/sbin/sshd -t && sudo systemctl reload ssh.service\n"
            "Open a fresh admin SSH session from the Mac before closing the held one. Then run:\n"
            f"{restore} --clear-marker"
        )

    def backup(self, previous):
        parent = self.storage(BACKUPS, 0o700)
        sync_directory(parent.parent)
        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ-")
        directory = Path(tempfile.mkdtemp(prefix=stamp, dir=parent))
        actions = []
        for name, record in reversed(tuple(previous.items())):
            target = shlex.quote(str(self.path(name)))
            if record is None:
                actions.append(f"rm -f -- {target}")
            else:
                saved = directory / name.lstrip("/")
                saved.parent.mkdir(parents=True, exist_ok=True)
                record.write(saved)
                for ancestor in saved.parents:
                    sync_directory(ancestor)
                    if ancestor == directory:
                        break
                actions.append(f"restore_file {shlex.quote(str(saved))} {target}")
        marker = shlex.quote(str(self.path(IN_PROGRESS)))
        script = [
            "set -euo pipefail",
            f"exec 9>>{shlex.quote(str(self.path(LOCK)))}",
            "flock -x 9",
            f"if [[ $(cat -- {marker}) != {shlex.quote(str(directory))} ]]; then",
            "    echo 'The in-progress marker does not name this backup.' >&2",
            "    exit 1",
            "fi",
            "if [[ ${1-} == --clear-marker ]]; then",
            f"    rm -- {marker}",
            f"    sync -- {shlex.quote(str(parent.parent))}",
            "    exit",
            "fi",
            "restore_file() {",
            '    local tmp',
            '    if cmp -s -- "$1" "$2" && [[ $(stat -c %a:%u:%g -- "$1") == "$(stat -c %a:%u:%g -- "$2")" ]]; then',
            "        return",
            "    fi",
            '    tmp=$(mktemp -- "${2%/*}/.home-front-restore.XXXXXXXX")',
            '    cp -p -- "$1" "$tmp"',
            '    sync -- "$tmp"',
            '    mv -fT -- "$tmp" "$2"',
            '    sync -- "${2%/*}"',
            "}",
            *actions,
        ]
        File(("\n".join(script) + "\n").encode(), 0o600, self.owner).write(directory / "restore.sh")
        sync_directory(parent)
        return directory

    def backup_marker(self, backup):
        return File(f"{backup}\n".encode(), 0o600, self.owner)

    def clear_marker(self):
        self.path(IN_PROGRESS).unlink(missing_ok=True)
        sync_directory(self.path(STATE))

    def rollback(self, backup, previous, baseline, marker_synced):
        path = self.path(IN_PROGRESS)
        marker = self.backup_marker(backup)
        try:
            if not marker_synced or File.read(path) != marker:
                marker.write(path)
        except (Error, OSError, KeyboardInterrupt) as error:
            raise Error(f"Rollback blocked before restoring files: could not durably mark backup {backup}: "
                        f"{str(error) or 'interrupted'}") from error
        failures = []
        for name, saved in reversed(tuple(previous.items())):
            path = self.path(name)
            try:
                if File.read(path) == saved:
                    print(f"Unchanged {name}", flush=True)
                    continue
                if saved is None:
                    path.unlink(missing_ok=True)
                    sync_directory(path.parent)
                else:
                    copy = File.read(backup / name.lstrip("/"))
                    if copy != saved:
                        raise Error("backup copy is missing or differs from the saved version")
                    copy.write(path)
                print(f"Restored {name}", flush=True)
            except (Error, OSError, KeyboardInterrupt) as error:
                failures.append(f"Could not restore {name}: {str(error) or 'interrupted'}")
        try:
            self.reload(baseline)
            print("sshd reloaded and root settings verified", flush=True)
        except (Error, OSError, ValueError, subprocess.SubprocessError, KeyboardInterrupt) as error:
            failures.append(f"SSH rollback unverified: {str(error) or 'interrupted'}")
        if failures:
            raise Error("\n".join([*failures, self.manual_restore(backup)]))
        self.clear_marker()

    def reload(self, baseline, machines=(), admin=None):
        live = self.path(CONFIG)
        self.run("sshd", "-t", "-f", str(live))
        self.check_service_args()
        self.check_admin(live, baseline)
        self.run("systemctl", "reload", SERVICE)
        self.check_admin(live, baseline)
        for machine in machines:
            self.check_machine(live, machine, admin)

    def apply_policy(self, machines, sources, install=None, authorize=None):
        original, candidate = self.main_config(installing=install is not None)
        global_config = self.scan_config(candidate)
        self.check_service_args()
        baseline = self.root_baseline(sources)
        self.check_fallback(baseline)
        activation = None
        new_machine = None
        updates = {}
        provisioned = {}
        group = self.lookup("group", GROUP) if machines else None
        self.check_existing_keys(machines)
        for name, machine in machines.items():
            account = self.lookup("passwd", name)
            adding = authorize and name == authorize[0].name
            if account is None and not adding:
                continue
            provisioned[name] = machine
            if account is None:
                if self.path(machine.key_file).exists():
                    raise Error(f"{name}: a key file exists without its account; remove {machine.key_file} first")
                new_machine = machine
            else:
                shadow = self.check_account(name, account, group)
                if account[4] != machine.account_policy:
                    raise Error(f"{name}: kind and ports are fixed for this account; use a new account name")
                if adding:
                    expiry = int(shadow[7] or "-1")
                    # Treat the expiry day itself as active because sshd and PAM differ at that boundary.
                    if 0 < expiry < int(time.time()) // 86400:
                        if self.has_processes(account_processes(name, account[2])):
                            raise Error(f"{name}: account still has processes; verify removal before re-adding")
                        activation = (name, account[2])
        if authorize:
            machine, key = authorize
            key_file = File(machine.authorized_key(key).encode(), 0o644, self.owner)
            if new_machine or activation:
                updates[machine.key_file] = key_file
            elif File.read(self.path(machine.key_file)) != key_file:
                raise Error(f"{machine.name}: active account key differs or is missing; run remove-machine first")

        state = self.storage(STATE, 0o700)
        sync_directory(state.parent)
        history = self.storage(f"{STATE}/sshd-before", 0o700)
        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ-")
        before = Path(tempfile.mkdtemp(prefix=stamp, dir=history))
        for number, ((host, address), settings) in enumerate(baseline.items(), 1):
            (before / f"{number:03d}-{host}-{address}.conf").write_text(settings)
        print(f"Saved root effective settings in {before}", flush=True)

        match = render(provisioned)
        with tempfile.TemporaryDirectory(prefix="candidate-", dir=state) as scratch:
            staged = Path(scratch) / "sshd_config"
            staged.write_text(global_config + match)
            self.run("sshd", "-t", "-f", str(staged))
            self.check_admin(staged, baseline)
            for machine in provisioned.values():
                self.check_machine(staged, machine, sources[0])

        self.storage("/etc/ssh/home-tunnel", 0o755)
        sync_directory(self.path("/etc/ssh"))
        updates[MATCH] = File(match.encode(), 0o644, self.owner)
        if install is not None:
            if not self.path(MACHINES).exists():
                updates[MACHINES] = File(b"# account kind ports [alive=secondsxcount]\n", 0o600, self.owner)
            self.path(PROGRAM).parent.mkdir(parents=True, exist_ok=True)
            sync_directory(self.path(PROGRAM).parent.parent)
            updates[PROGRAM] = File(install, 0o755, self.owner)
        updates[CONFIG] = File(candidate.encode(), original.mode, original.owner)
        previous = {name: File.read(self.path(name)) for name in updates}
        if previous[CONFIG] != original:
            raise Error(f"{CONFIG}: changed while checking the candidate")
        updates = {name: record for name, record in updates.items()
                   if record != previous[name] or (authorize and name == authorize[0].key_file)}
        previous = {name: previous[name] for name in updates}
        backup = self.backup(previous)
        print(f"Saved previous files in {backup}", flush=True)
        marker_synced = False
        try:
            self.backup_marker(backup).write(self.path(IN_PROGRESS))
            marker_synced = True
            if new_machine:
                activation = self.create_account(new_machine, group)
            for name, record in updates.items():
                record.write(self.path(name))
                if File.read(self.path(name)) != record:
                    raise Error(f"{name}: installed file differs on readback")
            self.reload(baseline, provisioned.values(), sources[0])
        except (Error, OSError, ValueError, subprocess.SubprocessError, KeyboardInterrupt) as error:
            try:
                self.rollback(backup, previous, baseline, marker_synced)
            except Error as rollback_error:
                raise Error(f"{str(error) or 'interrupted'}\n{rollback_error}") from error
            raise Error(f"{str(error) or 'interrupted'}; previous files restored and sshd reloaded") from error

        try:
            self.clear_marker()
        except (OSError, KeyboardInterrupt) as error:
            raise Error(f"SSH policy committed and verified, but clearing {IN_PROGRESS} failed: "
                        f"{str(error) or 'interrupted'}") from error
        # Activate only after the verified policy is beyond automatic or marker-based rollback.
        if activation:
            self.set_expiry(*activation, "")
        print("SSH policy verified after reload")

    def create_account(self, machine, group):
        if group is None:
            self.run("groupadd", "--system", GROUP)
            group = self.lookup("group", GROUP)
        # Not --system: useradd gives system accounts no aging fields and drops --expiredate. A regular account is
        # created already expired, so it is never usable before activation.
        self.run("useradd", "--no-create-home", "--gid", GROUP, "--home-dir", HOME,
                 "--shell", SHELL, "--password", "!", "--expiredate", "1970-01-02",
                 "--comment", machine.account_policy, machine.name)
        account = self.lookup("passwd", machine.name)
        if self.check_account(machine.name, account, group)[7] != "1" or account[4] != machine.account_policy:
            raise Error(f"{machine.name}: new account did not retain its expiry and policy")
        return machine.name, account[2]

    def lookup(self, database, name):
        result = self.run("getent", database, name, allowed=(0, 2))
        if result.returncode == 2:
            return None
        return result.stdout.rstrip("\n").split(":")

    def check_account(self, name, account, group):
        if (not group or len(group) != 4 or group[0] != GROUP
                or not account or len(account) != 7 or account[0] != name
                or not account[2].isdigit() or int(account[2]) == 0
                or account[3] != group[2] or account[5:] != [HOME, SHELL]):
            raise Error(f"{name}: existing account does not have the dedicated home-front identity")
        shadow = self.lookup("shadow", name)
        if not shadow or len(shadow) != 9 or shadow[0] != name or not shadow[1].startswith("!"):
            raise Error(f"{name}: account password is not locked")
        return shadow

    def set_expiry(self, name, uid, expiry):
        account = self.lookup("passwd", name)
        group = self.lookup("group", GROUP)
        shadow = self.check_account(name, account, group)
        if account[2] != uid:
            raise Error(f"{name}: passwd UID changed during the operation")
        if shadow[7] != expiry:
            self.run("usermod", "--expiredate", expiry, name)
            if self.check_account(name, account, group)[7] != expiry:
                raise Error(f"{name}: account expiry could not be verified")

    def add(self, machine, key, machines, sources):
        for other in self.path("/etc/ssh/home-tunnel").glob("*.keys"):
            if other != self.path(machine.key_file) and key in other.read_text():
                raise Error(f"{other}: public key is already assigned to another account")
        self.apply_policy(machines, sources, authorize=(machine, key))
        print(f"Authorized {machine.name}")

    def listeners(self):
        ports = set()
        for line in self.run("ss", "-H", "-ltn").stdout.splitlines():
            fields = line.split()
            if len(fields) < 5 or fields[0] != "LISTEN":
                raise Error("could not read TCP listeners from ss")
            ports.add(fields[3].rsplit(":", 1)[-1])
        return ports

    def has_processes(self, selectors, deadline=None):
        return any(self.run("pgrep", *selector, allowed=(0, 1),
                            timeout=30 if deadline is None else max(0, deadline - time.monotonic())).returncode == 0
                   for selector in selectors)

    def remove(self, name):
        if not NAME.fullmatch(name) or name == "root":
            raise Error(f"{name!r}: invalid home-front account name")
        account = self.lookup("passwd", name)
        if account is None:
            raise Error(f"{name}: passwd entry missing; establish the account identity at the server console")
        group = self.lookup("group", GROUP)
        self.check_account(name, account, group)
        recorded = recorded_machine(name, account[4])
        uid = account[2]
        key_file = self.path(f"/etc/ssh/home-tunnel/{name}.keys")
        failures = []
        try:
            routes = self.routes(optional=True)
        except FRONT_ERRORS as error:
            closure = self.disable_front(str(error))
        else:
            selected = [route.service for route in routes.values() if route.account == name]
            closure = self.close_routes(routes, selected) if selected else Closure()
        if closure.code == 3:
            failures.append(closure.detail)
        try:
            self.set_expiry(name, uid, "1")
        except (Error, OSError, subprocess.SubprocessError) as error:
            failures.append(str(error))
        try:
            key_file.unlink(missing_ok=True)
            if key_file.parent.is_dir():
                sync_directory(key_file.parent)
        except OSError as error:
            failures.append(str(error))
        selectors = account_processes(name, uid)
        deadline = time.monotonic() + 5

        def kill_pass():
            for selector in selectors:
                try:
                    self.run("pkill", "-KILL", *selector, allowed=(0, 1),
                             timeout=max(0, deadline - time.monotonic()))
                except (Error, OSError, subprocess.SubprocessError) as error:
                    failures.append(str(error))

        kill_pass()
        kill_pass()
        clean = False
        while time.monotonic() < deadline:
            live = self.has_processes(selectors, deadline)
            if not live and clean:
                break
            clean = not live
            if live:
                kill_pass()
            time.sleep(min(1, max(0, deadline - time.monotonic())))
        else:
            failures.append(f"UID {uid} or sshd processes for {name} could not be verified gone within 5 seconds")
        current = self.lookup("passwd", name)
        if self.check_account(name, current, group)[7] != "1":
            failures.append("account expiry could not be verified")
        if current[2] != uid:
            failures.append("passwd UID changed during removal")
        if os.path.lexists(key_file):
            failures.append("authorized key file is still present")
        if recorded.kind == "listen" and set(map(str, recorded.ports)) & self.listeners():
            failures.append("a port assigned to the listen account is still listening")
        if failures:
            if closure.code == 2:
                failures.insert(0, f"the public front is locked after {closure.detail}")
            raise Error("; ".join(failures))
        return closure.report()

    def status(self, machines, sources):
        _, config = self.main_config(installing=False)
        self.scan_config(config)
        routes = self.routes(optional=True)
        listeners = self.listeners() if machines or routes else set()
        healthy = True
        for machine in machines.values():
            if self.lookup("passwd", machine.name) is None:
                print(f"{machine.name} ({machine.kind}) | not provisioned")
                continue
            try:
                self.check_machine(self.path(CONFIG), machine, sources[0])
                policy = "verified"
            except Error as error:
                healthy = False
                policy = f"DIFFERS ({error})"
            key = "present" if self.path(machine.key_file).is_file() else "absent"
            ports = ", ".join(f"{port} {'listening' if str(port) in listeners else 'idle'}"
                              for port in machine.ports)
            print(f"{machine.name} ({machine.kind}) | policy {policy} | key {key} | {ports}")
            login = self.run("journalctl", "-q", "--no-pager", "-u", SERVICE, "-o", "short-iso",
                             "-n", "1", "--grep", f"Accepted publickey for {machine.name} from ",
                             allowed=(0, 1)).stdout.strip()
            print(f"  Last login: {login or 'none in the retained SSH journal'}")
        if not machines:
            print("SSH include in place. No machines declared.")
        locked = self.front_locked()
        print("Front locked (recorded states below are not served)" if locked else "Front unlocked")
        for route in routes.values():
            port = "listening" if str(route.port) in listeners else "idle"
            denial = None if locked or route.state == "off" else self.route_denial(route)
            state = "off" if locked else route.state + (f" (not served: {route.account} {denial})" if denial else "")
            print(f"{route.service} | {state} | {route.account} | {route.port} {port}")
        return 0 if healthy else 1


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    add = commands.add_parser("add-machine")
    add.add_argument("account")
    add.add_argument("pubkey", type=Path)
    commands.add_parser("remove-machine").add_argument("account")
    render_parser = commands.add_parser("render")
    hook = render_parser.add_mutually_exclusive_group()
    hook.add_argument("--for-start", action="store_true")
    hook.add_argument("--for-reload", action="store_true")
    commands.add_parser("status")
    route = commands.add_parser("route")
    route.add_argument("service")
    route.add_argument("account")
    route.add_argument("port", type=int)
    commands.add_parser("on").add_argument("service")
    commands.add_parser("off").add_argument("service", nargs="?")
    commands.add_parser("reconcile")
    commands.add_parser("_reload-front", help=argparse.SUPPRESS).add_argument("master", type=int)
    default_drop_in = Path(__file__).resolve().parents[1] / "deploy/systemd/haproxy-home-front.conf"
    commands.add_parser("_install", help=argparse.SUPPRESS).add_argument("drop_in", nargs="?", type=Path,
                                                                        default=default_drop_in)
    args = parser.parse_args()
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)
    try:
        server = Server(os.environ.get("HOME_FRONT_ROOT", "/"), os.environ.get("HOME_FRONT_RUNNER"))
        if server.root == Path("/") and os.geteuid() != 0:
            raise Error("run home-front as root")
        if args.command == "render" and (args.for_start or args.for_reload):
            server.render_for_start(strict=args.for_reload)
            return 0
        if args.command == "_reload-front":
            server.reload_front_worker(args.master)
            return 0
        with server.locked(shared=args.command == "status"):
            if args.command == "off":
                return server.off(args.service).report()
            if args.command == "reconcile":
                server.reconcile()
                return 0
            if args.command in ("route", "on"):
                if args.command == "route":
                    server.change_route(args.service, args.account, args.port)
                else:
                    server.change_route(args.service)
                return 0
            if os.path.lexists(server.path(IN_PROGRESS)):
                backup = Path(server.private_text(IN_PROGRESS).strip())
                if backup.parent != server.path(BACKUPS):
                    raise Error(f"{IN_PROGRESS}: invalid backup path {backup!s}")
                removing = args.command == "remove-machine"
                prefix = "REVOCATION UNCONFIRMED" if removing else "home-front"
                print(f"{prefix}: previous run interrupted; restore from the held admin session or console\n"
                      f"{server.manual_restore(backup)}", file=sys.stderr)
                return 3 if removing else 1
            if args.command == "_install":
                sources = server.sources()
                machines = server.machines() if os.path.lexists(server.path(MACHINES)) else {}
                server.apply_policy(machines, sources, install=Path(__file__).read_bytes())
                server.install_front(args.drop_in.read_bytes())
            elif args.command == "remove-machine":
                return server.remove(args.account)
            else:
                machines = server.machines()
                if args.command == "add-machine":
                    if args.account not in machines:
                        raise Error(f"{args.account!r}: account is not declared in {MACHINES}")
                    server.add(machines[args.account], read_public_key(args.pubkey), machines, server.sources())
                elif args.command == "render":
                    server.apply_policy(machines, server.sources())
                else:
                    return server.status(machines, server.sources())
        return 0
    except (Error, OSError, ValueError, subprocess.SubprocessError, KeyboardInterrupt) as error:
        if isinstance(error, KeyboardInterrupt):
            if args.command == "off":
                return 130
            error = "interrupted"
        if args.command == "off":
            return Closure(3, str(error)).report()
        if args.command == "remove-machine":
            print(f"REVOCATION UNCONFIRMED: {error}. From the server console, check the account and rerun removal. "
                  "To close the home tunnel directly, stop home-tunnel on the home machine. "
                  "For the public service, stop flat-remote on the home machine.")
            return 3
        print(f"home-front: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
