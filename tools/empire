#!/usr/bin/env python3
"""empire — update the Ares Empire hub without editing code.

Writes a small JSON state file (data/state.json) that the hub serves over GET /api/empire
and renders live. The frontend falls back to the embedded web/app/empire-data.js seed when
the API isn't reachable, so this never has to touch application code.

Examples
  empire log aresium "Shipped the PayPal reconciler"     # add a chronicle entry
  empire log empire "Wired the chronicle log to the API"  # 'empire' = the hub itself
  empire status arestoteles FORTIFYING                    # change a province's status
  empire feature aresium "CSV + XML import"               # add to a project's detail
  empire wip aresium "Recurring-transaction detection"    # add an in-progress item
  empire done aresium "Recurring-transaction detection"   # finish it (drops from WIP, logs it)
  empire idea aresium "Budget forecasting"                # add an add-on / idea
  empire show                                             # print the current state

Git hook entry point (installed per repo by tools/install-empire-hook):
  empire hook --slug aresium --message "$(git log -1 --pretty=%B)"
  …picks up '[log] <text>' and '[status:<STATE>]' markers in the commit message.

State path: $EMPIRE_STATE, else <repo>/data/state.json. Writes are atomic.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.request
from datetime import date

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def _load_dotenv(path):
    """Merge KEY=VALUE lines from the empire's .env into the environment (without overriding),
    so config (EMPIRE_LLM_*, EMPIRE_STATE) is available even when run from a git hook."""
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, _, v = line.partition("=")
                os.environ.setdefault(k.strip(), v.strip().strip('"').strip("'"))
    except OSError:
        pass


_load_dotenv(os.path.join(REPO, ".env"))

STATE_PATH = os.environ.get("EMPIRE_STATE", os.path.join(REPO, "data", "state.json"))
SEED_JS = os.path.join(REPO, "web", "app", "empire-data.js")
CHRONICLE_CAP = 60
DETAIL_KEYS = ("about", "features", "setup", "wip", "ideas", "changelog")

# ── Auto-fill (empire brief): a free LLM turns a project's docs + recent commits into its
# detail boxes. Dormant until EMPIRE_LLM_KEY is set in .env. Supports Gemini & Groq free tiers.
LLM_PROVIDER = os.environ.get("EMPIRE_LLM_PROVIDER", "gemini").lower()
LLM_KEY = os.environ.get("EMPIRE_LLM_KEY", "")
LLM_MODEL = os.environ.get("EMPIRE_LLM_MODEL", "")
# where each province's repo lives (for git log + docs). Defaults scan /root and /opt by slug.
REPO_ALIASES = {"arestemis": "/root/flatsniper", "arestoteles": "/opt/arestoteles", "empire": REPO}

# ── Telegram (the empire bot): outbound update pings + the inbound text→action bot (empire-bot).
TG_TOKEN = os.environ.get("EMPIRE_TG_TOKEN", "")
TG_CHAT = os.environ.get("EMPIRE_TG_CHAT", "")
TG_NOTIFY = os.environ.get("EMPIRE_TG_NOTIFY", "1") not in ("0", "false", "")


def _seed_from_js() -> dict | None:
    """Best-effort: build the initial state by evaluating the empire-data.js seed via node."""
    if not os.path.exists(SEED_JS):
        return None
    try:
        out = subprocess.check_output(
            ["node", "-e", f'globalThis.window={{}};require({json.dumps(SEED_JS)});'
                            f'process.stdout.write(JSON.stringify(globalThis.window.EMPIRE))'],
            stderr=subprocess.DEVNULL, timeout=15)
        return json.loads(out.decode("utf-8"))
    except Exception:
        return None


def load() -> dict:
    if os.path.exists(STATE_PATH):
        with open(STATE_PATH, "r", encoding="utf-8") as f:
            return json.load(f)
    seeded = _seed_from_js()
    if seeded is None:
        seeded = {"name": "ARES EMPIRE", "projects": [], "ideas": [], "chronicle": [], "STATUS": {}}
    save(seeded)
    return seeded


def save(state: dict) -> None:
    os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(STATE_PATH), suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(state, f, ensure_ascii=False, indent=2)
        os.replace(tmp, STATE_PATH)         # atomic
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)


def _esc(s):
    return str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def tg_send(text, chat=None):
    """Best-effort Telegram message to the empire chat. Returns True on success."""
    target = chat or TG_CHAT
    if not TG_TOKEN or not target:
        return False
    url = f"https://api.telegram.org/bot{TG_TOKEN}/sendMessage"
    body = {"chat_id": target, "text": text, "parse_mode": "HTML", "disable_web_page_preview": True}
    try:
        req = urllib.request.Request(url, data=json.dumps(body).encode(), headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=15) as r:
            return json.loads(r.read()).get("ok", False)
    except Exception:
        return False


def find_project(state: dict, slug: str) -> dict | None:
    return next((p for p in state.get("projects", []) if p.get("slug") == slug), None)


def ensure_detail(proj: dict) -> dict:
    d = proj.setdefault("detail", {})
    d.setdefault("about", "")
    for k in ("features", "wip", "ideas", "changelog"):
        d.setdefault(k, [])
    d.setdefault("setup", "")
    return d


def add_chronicle(state: dict, slug: str, text: str, when: str | None = None) -> None:
    entry = {"at": when or date.today().isoformat(), "project": slug, "text": text}
    chron = state.setdefault("chronicle", [])
    chron.insert(0, entry)                  # newest first
    del chron[CHRONICLE_CAP:]
    proj = find_project(state, slug)        # mirror into the province's own change log
    if proj is not None:
        ensure_detail(proj)["changelog"].insert(0, {"at": entry["at"], "text": text})
    if TG_NOTIFY:                           # ping the empire bot on every update
        tg_send(f"🏛 <b>{_esc((proj or {}).get('name', slug))}</b>\n{_esc(text)}")


# ---- commands ----------------------------------------------------------------
def cmd_log(state, a):
    add_chronicle(state, a.slug, a.text)
    return f"logged · {a.slug} · {a.text}"


def cmd_status(state, a):
    proj = find_project(state, a.slug)
    if proj is None:
        sys.exit(f"empire: no project '{a.slug}'")
    valid = set(state.get("STATUS", {}).keys())
    st = a.state.upper()
    if valid and st not in valid:
        sys.exit(f"empire: status must be one of {', '.join(sorted(valid))}")
    proj["status"] = st
    add_chronicle(state, a.slug, f"Status → {st}.")
    return f"{a.slug} status → {st}"


def _append(state, slug, key, text, label):
    proj = find_project(state, slug)
    if proj is None:
        sys.exit(f"empire: no project '{slug}'")
    ensure_detail(proj)[key].append(text)
    return f"{slug} · {label} +1 · {text}"


def cmd_feature(state, a): return _append(state, a.slug, "features", a.text, "feature")
def cmd_idea(state, a):    return _append(state, a.slug, "ideas", a.text, "idea")
def cmd_wip(state, a):     return _append(state, a.slug, "wip", a.text, "wip")


def cmd_about(state, a):
    proj = find_project(state, a.slug)
    if proj is None:
        sys.exit(f"empire: no project '{a.slug}'")
    ensure_detail(proj)["about"] = a.text
    return f"{a.slug} overview updated"


def _slugify(s):
    return re.sub(r"[^a-z0-9]+", "-", (s or "").lower()).strip("-")


def cmd_new(state, a):
    name = (a.name or "").strip()
    if not name:
        sys.exit("empire: a name is required")
    slug = a.slug or _slugify(name)
    if not slug:
        sys.exit("empire: could not derive a slug from the name")
    if find_project(state, slug):
        sys.exit(f"empire: project '{slug}' already exists")
    blurb = (a.blurb or "").strip()
    state.setdefault("projects", []).append({
        "slug": slug, "name": name, "url": "", "logo": "", "status": "MUSTERING", "domain": "",
        "blurb": blurb or f"{name} — newly declared.",
        "detail": {"about": blurb, "features": [], "setup": "", "wip": [], "ideas": [], "changelog": []},
    })
    add_chronicle(state, slug, f"Province declared: {name}.")
    return f"created project {slug} ({name})"


def cmd_notify(state, a):
    return "sent" if tg_send(_esc(a.text)) else "telegram not configured / send failed"


ASK_INSTRUCTIONS = (
    "You route ONE chat message to ONE action on a project dashboard.\n"
    "Projects (slug — name): {projects}\n"
    "Statuses: SCOUTED, MUSTERING, BESIEGING, CONQUERED, FORTIFYING.\n"
    'Return ONLY JSON {{"action","slug","name","text","state"}}; action is one of '
    "log, idea, wip, feature, status, new, none.\n"
    "Guide: ideas/plans -> idea; shipped/did/done/update -> log; working-on/todo -> wip; "
    "feature -> feature; 'set status'/'now live' -> status (+state); "
    "'new project NAME ...' -> new (name + text=description); match a project by loose name/slug; "
    "if unclear -> none.\n\nMessage: {msg}"
)


def cmd_ask(state, a):
    """Route a free-text message (from the bot) to an action and reply. Prints the reply text."""
    plist = "; ".join(f"{p['slug']} — {p.get('name', '')}" for p in state.get("projects", [])) or "(none)"
    try:
        act = _extract_json(_llm_json(ASK_INSTRUCTIONS.format(projects=plist, msg=a.text)))
    except Exception:
        print("🤔 I couldn't read that. Try “aresus: idea historical graphs”, or /help.")
        return None
    action = (act.get("action") or "none").lower()
    slug = (act.get("slug") or "").strip()
    text = (act.get("text") or "").strip()
    if action == "new":
        name = (act.get("name") or "").strip()
        ns = _slugify(name)
        if not ns:
            print("🤔 What should the new project be called?"); return None
        if find_project(state, ns):
            print(f"⚠️ <b>{_esc(name)}</b> already exists."); return None
        desc = text if text and text.lower() != name.lower() else ""
        state.setdefault("projects", []).append({
            "slug": ns, "name": name, "url": "", "logo": "", "status": "MUSTERING", "domain": "",
            "blurb": desc or f"{name} — newly declared.",
            "detail": {"about": desc, "features": [], "setup": "", "wip": [], "ideas": [], "changelog": []}})
        add_chronicle(state, ns, f"Province declared: {name}.")
        print(f"🆕 Declared <b>{_esc(name)}</b> — MUSTERING. It's in the circle now.")
        return None
    proj = find_project(state, slug)
    if action == "none" or proj is None:
        print(f"🤔 Which project did you mean? I know: {_esc(plist)}")
        return None
    name = proj.get("name", slug)
    if action == "idea":
        ensure_detail(proj)["ideas"].append(text); print(f"💡 Idea filed under <b>{_esc(name)}</b>: {_esc(text)}")
    elif action == "wip":
        ensure_detail(proj)["wip"].append(text); print(f"🛠 In-progress on <b>{_esc(name)}</b>: {_esc(text)}")
    elif action == "feature":
        ensure_detail(proj)["features"].append(text); print(f"✨ Feature on <b>{_esc(name)}</b>: {_esc(text)}")
    elif action == "status":
        st = (act.get("state") or "").upper()
        if st in state.get("STATUS", {}):
            proj["status"] = st; add_chronicle(state, slug, f"Status → {st}.")
            print(f"⚑ <b>{_esc(name)}</b> → {st}")
        else:
            print(f"🤔 Unknown status “{_esc(st)}”."); return None
    else:  # log
        add_chronicle(state, slug, text); print(f"📝 Logged on <b>{_esc(name)}</b>: {_esc(text)}")
    return None


def cmd_done(state, a):
    proj = find_project(state, a.slug)
    if proj is None:
        sys.exit(f"empire: no project '{a.slug}'")
    d = ensure_detail(proj)
    needle = a.text.lower()
    match = next((w for w in d["wip"] if needle in w.lower()), None)
    if match:
        d["wip"].remove(match)
    add_chronicle(state, a.slug, f"Done: {match or a.text}")
    return f"{a.slug} · done · {match or a.text}"


def _resolve_repo(slug):
    if slug in REPO_ALIASES and os.path.isdir(REPO_ALIASES[slug]):
        return REPO_ALIASES[slug]
    for base in ("/root", "/opt"):
        p = os.path.join(base, slug)
        if os.path.isdir(p):
            return p
    return None


def _read(path, limit=6000):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()[:limit]
    except OSError:
        return ""


def _gather_context(slug):
    repo = _resolve_repo(slug)
    ctx = {"claude_md": "", "readme": "", "commits": ""}
    if repo:
        ctx["claude_md"] = _read(os.path.join(repo, "CLAUDE.md"))
        for name in ("README.md", "README.MD", "readme.md", "README"):
            r = _read(os.path.join(repo, name))
            if r:
                ctx["readme"] = r
                break
        try:
            out = subprocess.check_output(
                ["git", "-C", repo, "log", "-30", "--pretty=%s"], stderr=subprocess.DEVNULL, timeout=10)
            ctx["commits"] = out.decode("utf-8", "replace")
        except Exception:
            pass
    return ctx, repo


def _brief_prompt(name, ctx):
    return (
        f'You write a concise dashboard card for the software PRODUCT "{name}", for its end users.\n'
        f"From its docs and recent commits below, produce the card. STRICT rules:\n"
        f"- Describe what the product does for its user. IGNORE all infrastructure/plumbing: the "
        f'"Ares Empire" hub, manifests, slugs, busts, commit hooks, SSO, registration, status words — '
        f"none of that is a feature.\n"
        f"- features = concrete user-facing capabilities (present or clearly planned). If the project "
        f"is only declared/planned, list its intended capabilities; do NOT invent beyond the docs.\n"
        f"- wip = real in-progress/pending build tasks if stated, else []. ideas = potential add-ons "
        f"if stated, else []. setup = one short line if the docs say how to run it, else \"\".\n"
        f"- Terse, factual, no marketing fluff. Lists <=6 items, strings <=120 chars.\n"
        f'Output ONLY JSON: {{"about": str, "features": [str], "setup": str, "wip": [str], "ideas": [str]}}.\n\n'
        f"=== CLAUDE.md ===\n{ctx['claude_md']}\n\n=== README ===\n{ctx['readme']}\n\n"
        f"=== recent commits ===\n{ctx['commits']}\n"
    )


_DEFAULT_MODEL = {
    "gemini": "gemini-2.0-flash",
    "groq": "llama-3.3-70b-versatile",
    "nvidia": "mistralai/mistral-small-4-119b-2603",
    "mistral": "mistralai/mistral-small-4-119b-2603",
}


def _llm_models():
    """Models to try in order: EMPIRE_LLM_MODEL (primary), then EMPIRE_LLM_FALLBACK_MODEL."""
    out = []
    primary = LLM_MODEL or _DEFAULT_MODEL.get(LLM_PROVIDER, "")
    if primary:
        out.append(primary)
    fb = os.environ.get("EMPIRE_LLM_FALLBACK_MODEL", "")
    if fb and fb not in out:
        out.append(fb)
    return out or [""]


def _llm_call_once(model, prompt):
    if LLM_PROVIDER == "gemini":                # serves Gemini AND Gemma (e.g. gemma-3-27b-it)
        url = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={LLM_KEY}"
        body = {"contents": [{"parts": [{"text": prompt}]}],
                "generationConfig": {"response_mime_type": "application/json", "temperature": 0.2}}
        headers = {"Content-Type": "application/json"}
        pick = lambda d: d["candidates"][0]["content"]["parts"][0]["text"]
    elif LLM_PROVIDER == "groq":
        url = "https://api.groq.com/openai/v1/chat/completions"
        body = {"model": model, "messages": [{"role": "user", "content": prompt}],
                "response_format": {"type": "json_object"}, "temperature": 0.2}
        headers = {"Content-Type": "application/json", "Authorization": f"Bearer {LLM_KEY}"}
        pick = lambda d: d["choices"][0]["message"]["content"]
    elif LLM_PROVIDER in ("nvidia", "mistral"):  # NVIDIA NIM — OpenAI-compatible; Mistral/Gemma/etc.
        url = "https://integrate.api.nvidia.com/v1/chat/completions"
        body = {"model": model, "messages": [{"role": "user", "content": prompt}],
                "temperature": 0.2, "max_tokens": 1024}
        headers = {"Content-Type": "application/json", "Authorization": f"Bearer {LLM_KEY}"}
        pick = lambda d: d["choices"][0]["message"]["content"]
    else:
        raise ValueError(f"unknown EMPIRE_LLM_PROVIDER '{LLM_PROVIDER}'")
    req = urllib.request.Request(url, data=json.dumps(body).encode(), headers=headers)
    with urllib.request.urlopen(req, timeout=60) as r:
        return pick(json.loads(r.read()))


def _llm_json(prompt):
    """Call the LLM, trying the primary model then any fallback. Returns raw text, or None."""
    if not LLM_KEY:
        return None
    err = None
    for model in _llm_models():
        try:
            return _llm_call_once(model, prompt)
        except Exception as e:
            err = e
            sys.stderr.write(f"empire: LLM model '{model}' failed ({e}); trying fallback\n")
    if err:
        raise err
    return None


def _extract_json(text):
    """Pull a JSON object out of an LLM reply (tolerates ```json fences / surrounding prose)."""
    if not text:
        raise ValueError("empty LLM reply")
    t = text.strip()
    m = re.search(r"```(?:json)?\s*(.+?)```", t, re.DOTALL)
    if m:
        t = m.group(1).strip()
    s, e = t.find("{"), t.rfind("}")
    if s != -1 and e > s:
        t = t[s:e + 1]
    return json.loads(t)


def _apply_brief(proj, fields):
    d = ensure_detail(proj)
    if isinstance(fields.get("about"), str) and fields["about"].strip():
        d["about"] = fields["about"].strip()
    if isinstance(fields.get("setup"), str):
        d["setup"] = fields["setup"].strip()
    for k in ("features", "wip", "ideas"):
        v = fields.get(k)
        if isinstance(v, list):
            d[k] = [str(x).strip() for x in v if str(x).strip()][:6]
    return d


def cmd_brief(state, a):
    proj = find_project(state, a.slug)
    if proj is None:
        sys.exit(f"empire: no project '{a.slug}'")
    ctx, repo = _gather_context(a.slug)
    if a.dry_run:
        print(_brief_prompt(proj.get("name", a.slug), ctx)[:4000])
        return None
    if a.mock:                                  # test path: apply a local JSON instead of calling the LLM
        fields = json.loads(_read(a.mock, 20000))
    else:
        if not LLM_KEY:
            return None                         # dormant until a free key is configured
        try:
            fields = _extract_json(_llm_json(_brief_prompt(proj.get("name", a.slug), ctx)))
        except Exception as e:
            sys.stderr.write(f"empire brief: {a.slug} skipped ({e})\n")
            return None
    d = _apply_brief(proj, fields)
    return f"briefed {a.slug} — about + {len(d.get('features', []))} features, {len(d.get('wip', []))} wip, {len(d.get('ideas', []))} ideas"


def cmd_hook(state, a):
    # markers must START a line (after optional whitespace) so inline examples / quotes in a
    # commit body — like the ones in this tool's own docs — never trigger a false entry.
    msg = a.message or ""
    out = []
    for m in re.finditer(r"^[ \t]*\[log\][ \t]*([^\[\n]+)", msg, re.IGNORECASE | re.MULTILINE):
        text = m.group(1).strip()
        if text:
            add_chronicle(state, a.slug, text)
            out.append(f"logged · {text}")
    sm = re.search(r"^[ \t]*\[status:\s*([A-Za-z]+)\s*\]", msg, re.IGNORECASE | re.MULTILINE)
    if sm:
        proj = find_project(state, a.slug)
        st = sm.group(1).upper()
        if proj is not None and st in set(state.get("STATUS", {}).keys()):
            proj["status"] = st
            out.append(f"status → {st}")
    return "\n".join(out) if out else None     # None → nothing to write


def cmd_show(state, a):
    print(f"projects: {', '.join(p['slug'] + ' [' + p.get('status','?') + ']' for p in state.get('projects', []))}")
    print(f"chronicle ({len(state.get('chronicle', []))}):")
    for c in state.get("chronicle", [])[:10]:
        print(f"  {c['at']}  {c.get('project','empire'):14} {c['text']}")
    return None      # read-only, no save


def cmd_seed(state, a):
    fresh = _seed_from_js()
    if fresh is None:
        sys.exit("empire: could not seed from empire-data.js (node + the file required)")
    # structure (projects · ideas · STATUS) comes from the JS seed, but keep the accumulated
    # runtime chronicle AND any runtime-added projects (e.g. created via the bot) so re-seeding
    # after a structural edit never erases the log or a province.
    if state.get("chronicle"):
        fresh["chronicle"] = state["chronicle"]
    seed_slugs = {p.get("slug") for p in fresh.get("projects", [])}
    for p in state.get("projects", []):
        if p.get("slug") not in seed_slugs:
            fresh.setdefault("projects", []).append(p)
    save(fresh)
    print(f"re-seeded {STATE_PATH} from empire-data.js (chronicle preserved)")
    sys.exit(0)


def main():
    p = argparse.ArgumentParser(prog="empire", description="Update the Ares Empire hub.")
    sub = p.add_subparsers(dest="cmd", required=True)

    def slug_text(name, help):
        s = sub.add_parser(name, help=help)
        s.add_argument("slug")
        s.add_argument("text", nargs="+")
        return s

    slug_text("log", "add a chronicle entry")
    slug_text("feature", "add a feature to a project's detail")
    slug_text("idea", "add an add-on / idea")
    slug_text("wip", "add an in-progress item")
    slug_text("done", "finish an in-progress item (drops it, logs it)")
    slug_text("about", "set a project's overview text")
    st = sub.add_parser("status", help="set a project's status")
    st.add_argument("slug"); st.add_argument("state")
    hk = sub.add_parser("hook", help="git-hook entry: parse [log]/[status:] from a commit message")
    hk.add_argument("--slug", required=True); hk.add_argument("--message", required=True)
    br = sub.add_parser("brief", help="LLM-summarise a project's docs+commits into its detail boxes")
    br.add_argument("slug"); br.add_argument("--dry-run", action="store_true")
    br.add_argument("--mock", help="apply a local JSON file instead of calling the LLM (testing)")
    nw = sub.add_parser("new", help="declare a new province (MUSTERING)")
    nw.add_argument("name"); nw.add_argument("--slug"); nw.add_argument("--blurb", default="")
    nt = sub.add_parser("notify", help="send a Telegram message via the empire bot")
    nt.add_argument("text", nargs="+")
    ak = sub.add_parser("ask", help="route a free-text message to an action (used by the bot)")
    ak.add_argument("text", nargs="+")
    sub.add_parser("show", help="print the current state")
    sub.add_parser("seed", help="(re)build state.json from empire-data.js")

    a = p.parse_args()
    # join multi-word text args
    if hasattr(a, "text") and isinstance(a.text, list):
        a.text = " ".join(a.text)

    handlers = {
        "log": cmd_log, "status": cmd_status, "feature": cmd_feature, "idea": cmd_idea,
        "wip": cmd_wip, "done": cmd_done, "about": cmd_about, "hook": cmd_hook,
        "brief": cmd_brief, "new": cmd_new, "notify": cmd_notify, "ask": cmd_ask,
        "show": cmd_show, "seed": cmd_seed,
    }
    state = load()
    result = handlers[a.cmd](state, a)
    if a.cmd not in ("show", "seed", "notify"):
        if a.cmd in ("hook", "brief") and result is None:
            return                          # no markers / nothing generated → don't rewrite the file
        save(state)
    if result:
        print(result)


