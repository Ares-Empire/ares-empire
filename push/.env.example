# Empire push service settings. On the server: /root/ares-empire/push/.env (never committed).
# Every line is optional; the values shown are the defaults.

# Empire accounts (PocketBase), checked for every app request.
EMPIRE_AUTH_URL=http://127.0.0.1:8090
# Only these socket peers may supply Caddy's forwarded client address.
AUTH_TRUSTED_PROXY=127.0.0.1,::1
# SQLite file: devices + outbox.
PUSH_DB=/var/lib/empire-push/push.db
# Listeners, both on 127.0.0.1. Caddy routes /api/push/* to the public one; the internal one is never routed.
PUSH_PUBLIC_PORT=8095
PUSH_INTERNAL_PORT=8096

# Apple Push Notification service. Leave empty for a dry run (messages only go to the outbox).
# The key is the .p8 file from developer.apple.com → Keys, owned by empire-push, mode 600.
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
